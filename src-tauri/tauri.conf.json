{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "TCG Binder",
  "identifier": "io.github.jrhorner1.tcgbinder",
  "build": {
    "frontendDist": "../ui"
  },
  "app": {
    "windows": [],
    "security": {
      "csp": null
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "category": "Utility",
    "shortDescription": "Trading card collection manager",
    "longDescription": "Track your trading card collection: what you own, what you paid, what it's worth, and how complete your sets are.",
    "copyright": "Jesse Horner",
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/128x128@2x.png", "icons/icon.icns", "icons/icon.ico"],
    "macOS": {
      "minimumSystemVersion": "11.0",
      "signingIdentity": "-"
    },
    "iOS": {
      "minimumSystemVersion": "15.0"
    }
  }
}
